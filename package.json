{
	"name": "@inv1x/pi-background-terminals",
	"version": "0.1.0",
	"description": "Session-scoped background process management for Pi",
	"type": "module",
	"license": "MIT",
	"author": "Inv1x",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Inv1x/pi-background-terminals.git"
	},
	"homepage": "https://github.com/Inv1x/pi-background-terminals#readme",
	"bugs": {
		"url": "https://github.com/Inv1x/pi-background-terminals/issues"
	},
	"publishConfig": {
		"access": "public"
	},
	"keywords": [
		"pi-package",
		"pi-coding-agent",
		"background-process",
		"terminal"
	],
	"files": [
		"src",
		"skills",
		"README.md",
		"CHANGELOG.md",
		"LICENSE",
		"config.example.json"
	],
	"exports": {
		".": "./src/index.ts"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		],
		"skills": [
			"./skills/background-terminals/SKILL.md"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"scripts": {
		"check": "biome check .",
		"check:fix": "biome check --write .",
		"typecheck": "tsc --noEmit",
		"test": "node --import jiti/register --test test/*.test.ts",
		"verify": "npm run check && npm run typecheck && npm test",
		"prepack": "npm run verify"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.5",
		"@earendil-works/pi-coding-agent": "0.84.1",
		"@earendil-works/pi-tui": "0.84.1",
		"@types/node": "^26.1.1",
		"jiti": "^2.7.0",
		"typebox": "1.3.7",
		"typescript": "^7.0.2"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
